; MW1: Critical Hit's title screen (src/mw1_menu.h), on MW1's screen template
; (src/mw1_screen.h; ANCHOR, LABEL_AT, LABEL_FONT, LABEL_OFF_FONT, TEXTS and
; the _WIDE layout are ours): our title picture (title_bg), the name over its
; sky, and MW1's buttons down the left: NEW, LOAD (the save), QUIT; the save
; named under them. All MW1's own art (mw1image.zbd), the cursor too: nothing
; of Pirate's Moon's (FIXES.md item 5; tests/test_mw1_look.cpp).
;
; MW1MENUDIALOG is 4:3's (640); MW1MENUDIALOG_WIDE the 16:9 canvas's (853).
(
MW1MENUDIALOG (
  CURSOR (BITMAP ("mw1_cursor") CENTER (1))
  PRIMITIVES (
    BACKGROUND (POSITION (-107 0) BITMAP ("mw1_title_bg") ANCHOR ("CENTRE"))
  )
  BUTTONS (
    NEW_CAMPAIGN (POSITION (40 300) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (132 306) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    CONTINUE (POSITION (40 338) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (132 344) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    ; On the hub now (its OPTIONS tile): kept for its id, never shown here.
    OPTIONS (POSITION (40 376) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (132 382) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    QUIT (POSITION (40 376) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (132 382) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
  )
  TEXTS (
    TITLE (POSITION (38 34) FONT ("mw1_title_43"))
    SUBTITLE (POSITION (42 96) FONT ("mw1_title_sub"))
    SAVE (POSITION (42 416) FONT ("mw1_note"))
  )
)
MW1MENUDIALOG_WIDE (
  CURSOR (BITMAP ("mw1_cursor") CENTER (1))
  PRIMITIVES (
    BACKGROUND (POSITION (0 0) BITMAP ("mw1_title_bg") ANCHOR ("CENTRE"))
  )
  BUTTONS (
    NEW_CAMPAIGN (POSITION (48 300) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (140 306) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    CONTINUE (POSITION (48 338) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (140 344) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    ; On the hub now (its OPTIONS tile): kept for its id, never shown here.
    OPTIONS (POSITION (48 376) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (140 382) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
    QUIT (POSITION (48 376) BITMAP ("mw1_button") ROLLOVER (BITMAP ("mw1_button_lit")) ACTIVATE (BITMAP ("mw1_button_down")) DISABLE (BITMAP ("mw1_button_off")) LABEL_AT (140 382) LABEL_FONT ("mw1_label") LABEL_OFF_FONT ("mw1_label_off"))
  )
  TEXTS (
    TITLE (POSITION (46 34) FONT ("mw1_title"))
    SUBTITLE (POSITION (50 96) FONT ("mw1_title_sub"))
    SAVE (POSITION (50 416) FONT ("mw1_note"))
  )
)
